# Copy to /etc/numra/numra.env with owner root:root and mode 0600.
# Private staging:
NUMRA_ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
NUMRA_LLM_ENABLED=false
NUMRA_DEEPSEEK_BASE_URL=https://api.deepseek.com
NUMRA_DEEPSEEK_MODEL=deepseek-v4-pro

# Set only after the provider/privacy launch gate has been approved:
NUMRA_DEEPSEEK_API_KEY=
NUMRA_RATE_LIMIT_HMAC_SECRET=
