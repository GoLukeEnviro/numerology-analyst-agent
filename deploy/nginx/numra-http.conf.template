server {
    listen 80;
    listen [::]:80;
    server_name ${NUMRA_DOMAIN};

    access_log off;
    error_log /var/log/nginx/numra-error.log warn;

    location ^~ /.well-known/acme-challenge/ {
        root /var/www/certbot;
        default_type text/plain;
        try_files $uri =404;
    }

    location / {
        return 404;
    }
}
